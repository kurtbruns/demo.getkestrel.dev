{
  "name": "demo.getkestrel.dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Per-visitor sandboxed live demo of Kestrel, served at demo.getkestrel.dev.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/fetch-kestrel.mjs",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "check": "npm run typecheck && biome check .",
    "format": "biome check --write .",
    "test": "npm run test:worker && npm run test:build",
    "test:worker": "vitest run",
    "test:build": "node --test \"test/build/**/*.test.mjs\"",
    "deploy": "wrangler deploy --env production",
    "deploy:check": "wrangler deploy --env production --dry-run --outdir dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261019.1": true
  }
}
