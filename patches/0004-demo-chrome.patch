diff --git a/client/demo.spec.ts b/client/demo.spec.ts
new file mode 100644
index 0000000..d20ff34
--- /dev/null
+++ b/client/demo.spec.ts
@@ -0,0 +1,131 @@
+// Demo sandbox (patched by demo.getkestrel.dev): in the demo's auth mode, the identity
+// chip names the sandbox, and a split pill in the corner opens a note about it, with the
+// reset as a second step, and links to the public site.
+
+import { beforeEach, describe, expect, it } from "vitest";
+import { renderIdentity } from "./auth";
+import { appState } from "./state";
+
+function signIn(mode: "demo" | "dev"): void {
+  document.getElementById("demoPill")?.remove();
+  appState.session = {
+    principal: { kind: "human", email: mode === "demo" ? "demo@getkestrel.dev" : "dev@localhost" },
+    auth: { mode },
+  } as typeof appState.session;
+  renderIdentity();
+}
+
+function pill(): HTMLElement {
+  const el = document.getElementById("demoPill");
+  if (!el) {
+    throw new Error("no demo pill");
+  }
+  return el;
+}
+
+describe("demo mode", () => {
+  beforeEach(() => signIn("demo"));
+
+  it("shows a Demo chip with no sign-out", () => {
+    const identity = document.getElementById("identity");
+    expect(identity?.textContent).toContain("Demo sandbox");
+    expect(identity?.querySelector("a[href*='logout']")).toBeNull();
+  });
+
+  it("shows the split pill: the Demo tag and View publication", () => {
+    const p = pill();
+    expect(p.getAttribute("aria-label")).toBe("Kestrel demo");
+    expect(p.querySelector(".demo-menu > summary")?.textContent).toContain("Demo");
+    const go = p.querySelector<HTMLAnchorElement>("a.demo-go");
+    expect(go?.textContent).toContain("View publication");
+    expect(go?.getAttribute("href")).toBe("/");
+    // It floats over the page, outside the routed view the router replaces.
+    expect(p.parentElement).toBe(document.body);
+    expect(p.closest(".layout")).toBeNull();
+  });
+
+  it("opens a note about the sandbox, with About Kestrel", () => {
+    const menu = pill().querySelector<HTMLDetailsElement>(".demo-menu");
+    expect(menu?.open).toBe(false);
+    expect(menu?.textContent).toContain("Kestrel demo sandbox");
+    expect(menu?.textContent).toContain("Only this browser can see it.");
+    expect(menu?.querySelector("a[href='https://getkestrel.dev']")?.textContent).toContain(
+      "About Kestrel",
+    );
+  });
+
+  it("puts the reset behind a second step, whose form posts to the demo's reset", () => {
+    const step = pill().querySelector<HTMLDetailsElement>(".demo-reset");
+    expect(step?.querySelector("summary")?.textContent).toBe("Reset demo…");
+    expect(step?.open).toBe(false);
+    expect(step?.textContent).toContain("Discard everything you've changed");
+    const form = step?.querySelector("form");
+    expect(form?.getAttribute("method")).toBe("post");
+    expect(form?.getAttribute("action")).toBe("/_demo/reset");
+    expect(form?.querySelector("button[type='submit']")?.textContent).toBe("Reset");
+    // The only form in the pill is the reset's.
+    expect(pill().querySelectorAll("form")).toHaveLength(1);
+  });
+
+  it("closes the step on Cancel, and the menu on Escape or a click outside", () => {
+    const menu = pill().querySelector<HTMLDetailsElement>(".demo-menu");
+    const step = pill().querySelector<HTMLDetailsElement>(".demo-reset");
+    if (!menu || !step) {
+      throw new Error("no menu");
+    }
+    menu.open = true;
+    step.open = true;
+    pill().querySelector<HTMLButtonElement>(".demo-cancel")?.click();
+    expect(step.open).toBe(false);
+    expect(menu.open).toBe(true);
+    expect(document.activeElement).toBe(step.querySelector("summary"));
+
+    // Escape from inside the pill closes it and hands focus back to the tag.
+    step
+      .querySelector("summary")
+      ?.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
+    expect(menu.open).toBe(false);
+    expect(document.activeElement).toBe(menu.querySelector("summary"));
+
+    menu.open = true;
+    document.body.click();
+    expect(menu.open).toBe(false);
+  });
+
+  it("leaves Escape elsewhere alone, and closes when focus leaves the pill", () => {
+    const menu = pill().querySelector<HTMLDetailsElement>(".demo-menu");
+    if (!menu) {
+      throw new Error("no menu");
+    }
+    const outside = document.createElement("button");
+    document.body.append(outside);
+    menu.open = true;
+    menu.querySelector<HTMLElement>("summary")?.focus();
+    outside.focus();
+    expect(menu.open).toBe(false);
+    menu.open = true;
+    document.body.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
+    expect(menu.open).toBe(true);
+    expect(document.activeElement).toBe(outside);
+    outside.remove();
+  });
+
+  it("renders the pill once, however often identity is rendered", () => {
+    renderIdentity();
+    expect(document.querySelectorAll("#demoPill")).toHaveLength(1);
+  });
+
+  it("no longer renders the banner or publishes --demo-h", () => {
+    expect(document.getElementById("demoBanner")).toBeNull();
+    expect(document.querySelector(".demo-banner")).toBeNull();
+    expect(document.documentElement.style.getPropertyValue("--demo-h")).toBe("");
+  });
+});
+
+describe("other modes", () => {
+  it("get no pill", () => {
+    signIn("dev");
+    expect(document.getElementById("demoPill")).toBeNull();
+    expect(document.getElementById("identity")?.textContent).toContain("Local dev");
+  });
+});
