diff --git a/client/demo.spec.ts b/client/demo.spec.ts
new file mode 100644
index 0000000..4de2ec9
--- /dev/null
+++ b/client/demo.spec.ts
@@ -0,0 +1,49 @@
+// Demo sandbox (patched by demo.getkestrel.dev): in the demo's auth mode, the identity
+// chip names the sandbox and the strip above the workspace links to the reset.
+
+import { beforeEach, describe, expect, it } from "vitest";
+import { renderIdentity } from "./auth";
+import { appState } from "./state";
+
+function signIn(mode: "demo" | "dev"): void {
+  document.getElementById("demoBanner")?.remove();
+  appState.session = {
+    principal: { kind: "human", email: mode === "demo" ? "demo@getkestrel.dev" : "dev@localhost" },
+    auth: { mode },
+  } as typeof appState.session;
+  renderIdentity();
+}
+
+describe("demo mode", () => {
+  beforeEach(() => signIn("demo"));
+
+  it("shows a Demo chip with no sign-out", () => {
+    const identity = document.getElementById("identity");
+    expect(identity?.textContent).toContain("Demo sandbox");
+    expect(identity?.querySelector("a[href*='logout']")).toBeNull();
+  });
+
+  it("shows the sandbox banner, linking to the reset's confirmation page", () => {
+    const banner = document.getElementById("demoBanner");
+    expect(banner?.textContent).toContain("private to this browser");
+    expect(banner?.querySelector("a.demo-reset")?.getAttribute("href")).toBe("/_demo/reset");
+    expect(banner?.querySelector("form")).toBeNull();
+    // It sits above the workspace, outside the routed view the router replaces.
+    expect(banner?.nextElementSibling?.classList.contains("layout")).toBe(true);
+    // Its height is published for the layout to make room for.
+    expect(document.documentElement.style.getPropertyValue("--demo-h")).toMatch(/px$/);
+  });
+
+  it("renders the banner once, however often identity is rendered", () => {
+    renderIdentity();
+    expect(document.querySelectorAll("#demoBanner")).toHaveLength(1);
+  });
+});
+
+describe("other modes", () => {
+  it("get no banner", () => {
+    signIn("dev");
+    expect(document.getElementById("demoBanner")).toBeNull();
+    expect(document.getElementById("identity")?.textContent).toContain("Local dev");
+  });
+});
