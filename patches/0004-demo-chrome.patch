+/**
+ * Demo sandbox (patched by demo.getkestrel.dev): a strip above the workspace saying the
+ * sandbox is private and temporary, with the reset. Rendered once, outside the routed
+ * view, so navigating never clears it. The reset is a plain same-origin form post to the
+ * demo Worker's own route, which answers with a redirect back here.
+ */
+function renderDemoBanner(): void {
+  if (document.getElementById("demoBanner")) {
+    return;
+  }
+  const banner = document.createElement("div");
+  banner.id = "demoBanner";
+  banner.className = "demo-banner";
+  banner.setAttribute("role", "note");
+  setHtml(
+    banner,
+    html`<span><strong>Demo sandbox.</strong> Your changes are private to this browser and are deleted after a day away. Nothing you send leaves the sandbox.</span><form method="post" action="/_demo/reset"><button type="submit" class="secondary">Reset demo</button></form><a href="https://getkestrel.dev">About Kestrel</a>`,
+  );
+  banner.querySelector("form")?.addEventListener("submit", (e) => {
+    if (
+      !confirm(
+        "Reset the demo? Everything you've changed in this sandbox is discarded and the sample publication is restored.",
+      )
+    ) {
+      e.preventDefault();
+    }
+  });
+  (document.querySelector(".layout") ?? app).before(banner);
+}
