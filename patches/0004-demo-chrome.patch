@@ -0,0 +1,54 @@
+// Demo sandbox (patched by demo.getkestrel.dev): in the demo's auth mode, the identity
+// chip names the sandbox and the strip above the workspace offers the reset.
+
+import { describe, expect, it, vi } from "vitest";
+import { renderIdentity } from "./auth";
+import { appState } from "./state";
+
+describe("demo mode", () => {
+  it("shows a Demo chip with no sign-out, and the sandbox banner with the reset", () => {
+    appState.session = {
+      principal: { kind: "human", email: "demo@getkestrel.dev" },
+      auth: { mode: "demo" },
+    } as typeof appState.session;
+    renderIdentity();
+
+    const identity = document.getElementById("identity");
+    expect(identity?.textContent).toContain("Demo sandbox");
+    expect(identity?.querySelector("a[href*='logout']")).toBeNull();
+
+    const banner = document.getElementById("demoBanner");
+    expect(banner?.textContent).toContain("private to this browser");
+    const form = banner?.querySelector("form");
+    expect(form?.getAttribute("method")).toBe("post");
+    expect(form?.getAttribute("action")).toBe("/_demo/reset");
+    // It sits above the workspace, outside the routed view the router replaces.
+    expect(banner?.nextElementSibling?.classList.contains("layout")).toBe(true);
+
+    // Rendering again (a later identity refresh) doesn't add a second banner.
+    renderIdentity();
+    expect(document.querySelectorAll("#demoBanner")).toHaveLength(1);
+  });
+
+  it("asks before resetting", () => {
+    const form = document.querySelector<HTMLFormElement>("#demoBanner form");
+    const confirm = vi.fn(() => false);
+    vi.stubGlobal("confirm", confirm);
+    const event = new Event("submit", { cancelable: true });
+    form?.dispatchEvent(event);
+    expect(confirm).toHaveBeenCalled();
+    expect(event.defaultPrevented).toBe(true);
+    vi.unstubAllGlobals();
+  });
+
+  it("leaves the other modes without the banner", () => {
+    document.getElementById("demoBanner")?.remove();
+    appState.session = {
+      principal: { kind: "human", email: "dev@localhost" },
+      auth: { mode: "dev" },
+    } as typeof appState.session;
+    renderIdentity();
+    expect(document.getElementById("demoBanner")).toBeNull();
+    expect(document.getElementById("identity")?.textContent).toContain("Local dev");
+  });
+});
