{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kestrel-demo",
  "main": "src/index.ts",
  // Kestrel's own date and flags (its wrangler.jsonc at the pinned tag), since its code runs here.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The `kestrel` module: Kestrel's code at the pinned, patched tag (kestrel/entry.ts).
  "alias": { "kestrel": "./kestrel/entry.ts" },
  "rules": [
    // Kestrel imports its demo posts and setup docs as text. Its css-inline .wasm import needs
    // nothing here: wrangler's default CompiledWasm rule covers **/*.wasm.
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": true },
    // Kestrel's migrations, applied inside each sandbox (src/d1/migrate.ts).
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true },
    // The seed's demo images, as ArrayBuffers (vendor/demo-assets.ts).
    {
      "type": "Data",
      "globs": ["**/*.webp", "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif"],
      "fallthrough": true
    }
  ],
  // The port APP_ORIGIN names below, so the links Kestrel builds from it resolve locally.
  "dev": { "port": 8788 },
  // Kestrel's built admin tree, from scripts/fetch-kestrel.mjs. Identical for every visitor.
  "assets": { "directory": "./vendor/kestrel/dist/public", "not_found_handling": "none" },
  // Clone, patch and build Kestrel at .kestrel-version; a no-op when vendor/ is current.
  "build": {
    "command": "node scripts/fetch-kestrel.mjs",
    "watch_dir": ["./src", "./kestrel", "./patches"]
  },
  // Media for every sandbox; #5 scopes each sandbox to its own prefix.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kestrel-demo-media-dev" }],
  // One SQLite-backed Durable Object per visitor (DESIGN.md, "Architecture").
  "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "SandboxDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SandboxDO"] }],
  // New sandboxes per IP per minute (src/index.ts). Each costs a migrate, a seed of several
  // hundred statements, and its storage; a returning visitor's cookie skips this.
  "ratelimits": [
    { "name": "NEW_SESSIONS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    // The origin Kestrel's links use. Production sets https://demo.getkestrel.dev (#10).
    "APP_ORIGIN": "http://localhost:8788"
  },
  // Production, at demo.getkestrel.dev. Wrangler doesn't inherit bindings or vars into a
  // named environment, so each is declared again here. Deploy it with
  // `npm run deploy` (CI does, once enabled; see README.md), never a bare `wrangler deploy`,
  // which would deploy the development config above.
  "env": {
    "production": {
      "name": "kestrel-demo",
      "vars": { "APP_ORIGIN": "https://demo.getkestrel.dev" },
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kestrel-demo-media" }],
      "durable_objects": { "bindings": [{ "name": "SANDBOX", "class_name": "SandboxDO" }] },
      "ratelimits": [
        { "name": "NEW_SESSIONS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
      ],
      // A Custom Domain: the first deploy creates its DNS record and certificate in the
      // getkestrel.dev zone, which must be in the same Cloudflare account.
      "routes": [{ "pattern": "demo.getkestrel.dev", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
